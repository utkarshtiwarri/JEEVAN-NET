# Copy to .env.local (same folder) and fill in your project's values.
# Supabase dashboard -> Project Settings -> API.
# Publishable keys are intended for browser use. Never put a secret or
# service_role key here; those bypass row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
